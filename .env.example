# 复制本文件为 .env，然后填写

# ===== QQ 官方机器人（q.qq.com 开发 > 开发设置 里看） =====
QQ_APPID=
QQ_SECRET=
# 机器人还没审核上线时，只能在沙箱群/沙箱频道里用，设为 true
QQ_SANDBOX=true

# ===== 大模型（任何 OpenAI 兼容接口都行，三选一或自己填） =====
# Claude
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL=claude-sonnet-5-5
LLM_VISION=true
# DeepSeek（不支持看图，LLM_VISION 改成 false）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_VISION=false
# 通义千问（看图用 qwen-vl-max，纯文字用 qwen-plus）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-vl-max
# LLM_VISION=true
LLM_API_KEY=

# ===== 机器人自己 =====
BOT_NAME=Atrei
# 想要什么性格就写在这，比如：说话可爱一点，偶尔用颜文字
BOT_PERSONA=
TIMEZONE=Asia/Shanghai
# 记住最近几轮对话
HISTORY_TURNS=10
